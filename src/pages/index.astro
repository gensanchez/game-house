---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Offers from '../components/Offers.astro';
import HoursLocation from '../components/HoursLocation.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import Pricing from '../components/Pricing.astro';
---

<Layout
  title="The Game House | A Board Game Café · North Providence"
  description="A cozy board game café in North Providence. 100+ games, specialty coffee, great food, and even better company."
>
  <Navbar />
  <main>
    <Hero />
    <div class="desktop-only">
      <About />
      <Offers />
      <Pricing />
    </div>
    <HoursLocation />
    <CTA />
  </main>
  <Footer />
</Layout>

<style>
  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }
  }
</style>