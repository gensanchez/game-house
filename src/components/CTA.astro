---

<section class="cta" id="cta">
  <div class="cta__bg" aria-hidden="true"></div>
  <div class="cta__glow" aria-hidden="true"></div>

  <div class="container cta__inner">
    <div class="cta__content reveal">
      <span class="section-label">Ready to Play?</span>
      <h2 class="cta__heading">
        Your Next Favorite<br />
        <em>Game Night</em> Starts Here.
      </h2>
      <div class="divider divider--center"></div>
      <p class="cta__desc">
        No reservations needed for small groups — just walk in, grab a game, and
        make yourself at home. For larger groups or special occasions, reach out
        and we'll set everything up for you.
      </p>
      <p class="cta__desc">
        No reservations needed for small groups — just walk in and grab a game.
        For larger groups or special occasions, slide into our DMs on Instagram
        or give us a call and we'll set everything up for you.
      </p>

      <div class="cta__actions">
        <a
          href="https://instagram.com/thegamehouseri"
          target="_blank"
          rel="noopener noreferrer"
          class="cta__btn cta__btn--insta"
        >
          <span class="cta__btn-icon">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </span>
          <span class="cta__btn-text">
            <small>Reserve or Ask Us Anything</small>
            <strong>DM on Instagram</strong>
          </span>
        </a>

        <a href="tel:+14015551234" class="cta__btn cta__btn--gold">
          <span class="cta__btn-icon">
            <svg
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"
              ></path>
            </svg>
          </span>
          <span class="cta__btn-text">
            <small>Prefer to Talk?</small>
            <strong>Give Us a Call</strong>
          </span>
        </a>
      </div>

      <p class="cta__address">📍 1726 Smith Street, North Providence</p>
    </div>

    <div class="cta__deco" aria-hidden="true">
      <span class="cta__piece cta__piece--1">♛</span>
      <span class="cta__piece cta__piece--2">♞</span>
      <span class="cta__piece cta__piece--3">⬡</span>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: var(--section-pad);
    background: var(--black-card);
    overflow: hidden;
    text-align: center;
  }
  .cta__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 100%,
        rgba(201, 168, 76, 0.08) 0%,
        transparent 70%
      ),
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 40px,
        rgba(201, 168, 76, 0.015) 40px,
        rgba(201, 168, 76, 0.015) 41px
      );
    pointer-events: none;
  }
  .cta__glow {
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(201, 168, 76, 0.12) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
  .cta::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(201, 168, 76, 0.4),
      transparent
    );
  }
  .cta__inner {
    position: relative;
    z-index: 2;
  }
  .cta__content {
    max-width: 680px;
    margin: 0 auto;
  }
  .cta__heading {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: var(--cream);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .cta__heading em {
    color: var(--gold);
    font-style: italic;
  }
  .cta__desc {
    font-size: 1.05rem;
    color: var(--cream-dim);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 2.5rem;
  }
  .cta__actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.75rem;
    border-radius: 3px;
    text-align: left;
    transition: all 0.3s ease;
    min-width: 220px;
  }
  .cta__btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cta__btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .cta__btn-text small {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .cta__btn-text strong {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cta__btn--gold {
    background: var(--gold);
    color: var(--black);
    box-shadow: 0 4px 20px rgba(201, 168, 76, 0.2);
  }
  .cta__btn--gold .cta__btn-icon {
    background: rgba(0, 0, 0, 0.15);
  }
  .cta__btn--gold:hover {
    background: var(--gold-light);
    transform: translateY(-3px);
    box-shadow: 0 10px 35px rgba(201, 168, 76, 0.35);
  }
  .cta__btn--insta {
    background: transparent;
    color: var(--cream);
    border: 1px solid rgba(245, 239, 224, 0.2);
  }
  .cta__btn--insta .cta__btn-icon {
    background: linear-gradient(
      135deg,
      #f09433,
      #e6683c,
      #dc2743,
      #cc2366,
      #bc1888
    );
    color: white;
  }
  .cta__btn--insta:hover {
    border-color: rgba(245, 239, 224, 0.4);
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.03);
  }
  .cta__address {
    font-size: 0.85rem;
    color: rgba(201, 191, 168, 0.5);
    letter-spacing: 0.05em;
    max-width: unset;
    margin: 0 auto;
  }
  .cta__deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }
  .cta__piece {
    position: absolute;
    color: rgba(201, 168, 76, 0.05);
  }
  .cta__piece--1 {
    top: 5%;
    left: 3%;
    font-size: 10rem;
    animation: floatPiece 9s ease-in-out infinite;
  }
  .cta__piece--2 {
    bottom: 10%;
    right: 4%;
    font-size: 7rem;
    animation: floatPiece 11s ease-in-out infinite reverse;
  }
  .cta__piece--3 {
    top: 15%;
    right: 8%;
    font-size: 5rem;
    animation: floatPiece 13s ease-in-out infinite 2s;
  }
  @keyframes floatPiece {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
  }
  @media (max-width: 600px) {
    .cta__btn {
      min-width: 100%;
      justify-content: center;
    }
    .cta__actions {
      gap: 0.75rem;
    }
    .cta__piece {
      display: none;
    }
  }
</style>
