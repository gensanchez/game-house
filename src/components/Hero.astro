---
import logoImg from "../assets/game-house-logo2.png";
---

<section class="hero" id="hero">
  <div class="hero__bg-pattern"></div>
  <div class="hero__glow"></div>
  <div class="hero__deco hero__deco--tl" aria-hidden="true">♟</div>
  <div class="hero__deco hero__deco--br" aria-hidden="true">⬡</div>
  <div class="hero__deco hero__deco--tr" aria-hidden="true">✦</div>

  <div class="hero__content">
    <p class="hero__eyebrow">Welcome to</p>
    <img
      src={logoImg.src}
      alt="The Game House - A Board Game Café"
      class="hero__logo-img"
    />

    <div class="hero__divider">
      <span class="hero__divider-line"></span>
      <span class="hero__divider-icon">♜</span>
      <span class="hero__divider-line"></span>
    </div>

    <p class="hero__desc">
      Gather your crew. Pick a game. Let the night unfold.<br />
      Good coffee meets great company.
    </p>

    <div class="hero__actions">
      <a
        href="https://instagram.com/thegamehouseri"
        target="_blank"
        rel="noopener"
        class="btn btn--primary"
      >
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
          ></path>
        </svg>
        DM to Reserve
      </a>
      <a href="tel:+14015551234" class="btn btn--outline">
        <svg
          width="16"
          height="16"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"
          ></path>
        </svg>
        or Call Us
      </a>
    </div>

    <div class="hero__hours-peek">
      <span class="hero__hours-time">
        Mon–Thu: 5–9pm &nbsp;|&nbsp; Fri: 5–10pm &nbsp;|&nbsp; Sat–Sun: 2–10pm
      </span>
    </div>

    <a
      href="https://maps.google.com/?q=1726+Smith+Street+North+Providence+RI"
      target="_blank"
      rel="noopener noreferrer"
      class="hero__address"
    >
      1726 Smith Street, North Providence
    </a>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-text">Scroll</span>
    <div class="hero__scroll-bar"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 8rem 2rem 8rem;
    background: var(--black);
  }
  .hero__bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(201, 168, 76, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(201, 168, 76, 0.04) 0%, transparent 40%),
      repeating-linear-gradient(0deg, transparent, transparent 60px, rgba(201, 168, 76, 0.025) 60px, rgba(201, 168, 76, 0.025) 61px),
      repeating-linear-gradient(90deg, transparent, transparent 60px, rgba(201, 168, 76, 0.025) 60px, rgba(201, 168, 76, 0.025) 61px);
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero__deco {
    position: absolute;
    color: rgba(201, 168, 76, 0.06);
    pointer-events: none;
    user-select: none;
  }
  .hero__deco--tl { top: 12%; left: 6%; font-size: 8rem; animation: float 8s ease-in-out infinite; }
  .hero__deco--br { bottom: 15%; right: 5%; font-size: 10rem; animation: float 10s ease-in-out infinite reverse; }
  .hero__deco--tr { top: 18%; right: 8%; font-size: 4rem; animation: float 12s ease-in-out infinite 2s; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-18px); }
  }
  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    animation: fadeUp 1s ease forwards;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
    font-weight: 500;
    max-width: unset;
    animation: fadeUp 1s ease 0.1s both;
  }
  .hero__logo-img {
    width: min(420px, 85vw);
    height: auto;
    mix-blend-mode: screen;
    margin: 0 auto 0.5rem;
    animation: fadeUp 1s ease 0.2s both;
  }
  .hero__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2rem auto;
    animation: fadeUp 1s ease 0.35s both;
  }
  .hero__divider-line {
    display: block;
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-dim));
  }
  .hero__divider-line:last-child {
    background: linear-gradient(270deg, transparent, var(--gold-dim));
  }
  .hero__divider-icon { color: var(--gold); font-size: 1.1rem; }
  .hero__desc {
    font-size: 1.1rem;
    color: var(--cream-dim);
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 2.5rem;
    animation: fadeUp 1s ease 0.4s both;
  }
  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 1s ease 0.5s both;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }
  .btn--primary { background: var(--gold); color: var(--black); }
  .btn--primary:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201, 168, 76, 0.25);
  }
  .btn--outline {
    background: transparent;
    color: var(--cream);
    border: 1px solid rgba(245, 239, 224, 0.3);
  }
  .btn--outline:hover {
    border-color: var(--gold);
    color: var(--gold);
    transform: translateY(-2px);
  }
  .hero__hours-peek {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    color: rgba(201, 191, 168, 0.6);
    letter-spacing: 0.05em;
    animation: fadeUp 1s ease 0.6s both;
  }
  .hero__hours-time { color: rgba(201, 191, 168, 0.8); }
  .hero__address {
    display: block;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: rgba(201, 191, 168, 0.5);
    letter-spacing: 0.05em;
    border-bottom: 1px solid transparent;
    transition: color 0.25s ease, border-color 0.25s ease;
    animation: fadeUp 1s ease 0.65s both;
  }
  .hero__address:hover {
    color: var(--gold);
    border-bottom-color: var(--gold-dim);
  }
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: fadeUp 1s ease 0.8s both;
    z-index: 3;
    pointer-events: none;
  }
  .hero__scroll-text {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(201, 168, 76, 0.5);
  }
  .hero__scroll-bar {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }
  @media (max-width: 600px) {
    .hero { padding: 7rem 1.25rem 7rem; }
    .hero__deco--tl, .hero__deco--br, .hero__deco--tr { display: none; }
    .hero__desc { font-size: 1rem; max-width: 100%; }
    .hero__actions { flex-direction: column; align-items: center; }
    .btn { width: 100%; justify-content: center; }
    .hero__hours-peek { flex-direction: column; gap: 0.25rem; text-align: center; }
    .hero__address { text-align: center; }
  }
</style>